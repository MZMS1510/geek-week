# Postgres connection (Vercel Postgres, Neon, Supabase, ...)
DATABASE_URL="postgresql://user:password@host:5432/semana_geek?schema=public"

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Local dev: http://localhost:3000. Vercel sets this automatically in prod.
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails that should be ADMIN on first sign-in.
ADMIN_EMAILS="marcos.marcondes@sou.inteli.edu.br"

# Restrict sign-in to this email domain.
ALLOWED_EMAIL_DOMAIN="sou.inteli.edu.br"
