generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  STAFF
  ADMIN
}

enum EventDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  FRIDAY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(PARTICIPANT)
  qrToken       String    @unique
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  receivedAwards PointAward[] @relation("participant")
  givenAwards    PointAward[] @relation("awarder")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Activation {
  id            String   @id @default(cuid())
  name          String
  description   String?
  day           EventDay
  defaultPoints Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  awards PointAward[]
}

model PointAward {
  id            String      @id @default(cuid())
  participantId String
  awarderId     String
  activationId  String?
  points        Int
  note          String?
  createdAt     DateTime    @default(now())

  participant User        @relation("participant", fields: [participantId], references: [id], onDelete: Cascade)
  awarder     User        @relation("awarder", fields: [awarderId], references: [id])
  activation  Activation? @relation(fields: [activationId], references: [id])

  @@index([participantId])
  @@index([createdAt])
}

model AppSetting {
  key   String @id
  value String
}
